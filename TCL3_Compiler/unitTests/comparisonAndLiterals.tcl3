// EXPECT: 1
// EXPECT: 0
// EXPECT: 65
// EXPECT: 1
// EXPECT: 1
// EXPECT: 1
// EXPECT: 0
// EXPECT: 0
// EXPECT: 1
// EXPECT: 65
// EXPECT: 7
// EXPECT: 65
// EXPECT: 8
// EXPECT: 65
// EXPECT: 7
// EXPECT: 65
// EXPECT: 0
// EXPECT: 1
// EXPECT: 1
// EXPECT: 2

fn readInt(value: int): int value;

fn readIntPointer(value: int*): int {return *value;}

fn recordEvaluation(counter: int*): int {
	*counter += 1;
	return 1;
}

fn main(): void {
	out true;
	out false;
	out 'A';

	out 3 < 4;
	out 3 <= 3;
	out 4 > 3;
	out 4 >= 5;

	out true && false;
	out false || true;

	// Distinct primitive sizes require a value cast before reading through an int pointer.
	let letter: char = 'A';
	let truthy: bool = <bool>7;
	out letter;
	out truthy;

	let letterPointer: char* = &letter;
	let integerFromLetter: int = <int>*letterPointer;
	let integerPointer: int* = &integerFromLetter;
	out *integerPointer;

	let integerValue: int = <int>truthy;
	integerValue += 1;
	out integerValue;

	out readInt(<int>letter);
	out readInt(<int>truthy);
	out readIntPointer(integerPointer);

	// Logical operators are eager rather than short-circuiting.
	let evaluationCount = 0;
	out false && <bool>recordEvaluation(&evaluationCount);
	out evaluationCount;
	out true || <bool>recordEvaluation(&evaluationCount);
	out evaluationCount;
}
