// EXPECT: 10

struct Point {
	x: int;
	y: int;

	fn "+"(other: Point): Point {
		let result: Point = {x: this->x + other.x, y: this->y + other.y};
		return result;
	}
}

fn makePoint(x: int, y: int): Point {
	let result: Point = {x: x, y: y};
	return result;
}

fn main(): void {
	let point: Point = {x: 8, y: 9};
	out (makePoint(2, 3) + point).x;
}
