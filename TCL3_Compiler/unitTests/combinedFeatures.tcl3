// EXPECT: 42
// EXPECT: 4
// EXPECT: 10
// EXPECT: 68
// EXPECT: 17
// EXPECT: 1
// EXPECT: 70
// EXPECT: 9
// EXPECT: 3

enum TransformMode {
	increment,
	double
}

struct Stats {
	total: int;
	count: int;

	fn record(value: int): void {
		this->total += value;
		this->count += 1;
	}

	fn average(): int {
		return this->total / this->count;
	}
}

struct Pipeline {
	apply: Fn<int, int>;
	stats: Stats;
}

struct Item {
	value: int;
	weight: int;
}

fn increment(value: int): int value + 1

fn double(value: int): int value * 2

fn makeItem(value: int, weight: int): Item {
	let item: Item = {value: value, weight: weight};
	return item;
}

fn main(): void {
	let itemCount: int = 4;
	let items: Item[itemCount] = {
		makeItem(1, 2),
		makeItem(3, 1),
		makeItem(5, 3),
		makeItem(7, 2)
	};

	let emptyStats: Stats = {total: 0, count: 0};
	let pipeline: Pipeline = {apply: increment};
	pipeline.stats = emptyStats;

	for (let index: int = 0; index < itemCount; index += 1) {
		let transformed = pipeline.apply(items[index].value);
		pipeline.stats.record(transformed * items[index].weight);
	}
	out pipeline.stats.total;
	out pipeline.stats.count;
	out pipeline.stats.average();

	let mode: TransformMode = TransformMode.double;
	if (mode == TransformMode.double) {
		pipeline.apply = double;
	} else {
		pipeline.apply = increment;
	}

	pipeline.stats.total = 0;
	pipeline.stats.count = 0;
	for (let secondIndex: int = 0; secondIndex < itemCount; secondIndex += 1) {
		let secondTransform = pipeline.apply(items[secondIndex].value);
		pipeline.stats.record(secondTransform * items[secondIndex].weight);
	}
	out pipeline.stats.total;
	out pipeline.stats.average();

	if (pipeline.stats.total >= 60 && pipeline.stats.count == itemCount) {
		out true;
	} else {
		out false;
	}

	let totalPointer = &pipeline.stats.total;
	*totalPointer += 2;
	out pipeline.stats.total;

	out makeItem(9, 4).value;
	out sizeof(Pipeline);
}
