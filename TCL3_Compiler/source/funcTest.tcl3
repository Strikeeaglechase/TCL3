// EXPECT: 11
// EXPECT: 41
// EXPECT: 24
// EXPECT: 1
// EXPECT: 2

struct Point {
	x: int;
	y: int;

	// p: Point;

	fn get_x(): int {
		return this->x;
	}

	fn get_y(): int {
		return this->y;
	}

	fn scale(factor: int): void {
		this->x *= factor;
		this->y *= factor;
	}

	fn scale(pt: Point): void {
		this->x *= pt.x;
		this->y *= pt.y;
	}
}

// ISS-021
struct First {
	static fn value(): int {
		return 1;
	}
}

struct Second {
	static fn value(): int {
		return 2;
	}
}

fn make_point(x: int, y: int): Point {
	let p: Point = {x: x, y: y};
	return p;
}

fn main(): void {
	let points: Point[2] = {make_point(11, 12), make_point(31, 41)};

	out points[0].get_x();
	out points[1].get_y();


	points[0].scale(2);
	out points[0].get_y();


	out First.value();
	out Second.value();
}
