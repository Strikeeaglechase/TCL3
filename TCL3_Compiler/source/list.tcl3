#parameter T: any

#export %T%List
struct %T%List {
	data: %T%*;
	length: int;
	capacity: int;

	static fn new(length: int): %T%List {
		let list: %T%List = {length: 0, capacity: length};

		list.data = <%T%*>malloc(length * sizeof(%T%));

		return list;
	}

