// EXPECT: 2
// EXPECT: 3
// EXPECT: 4
// EXPECT: 5
// EXPECT: 6

fn map(arr: int*, size: int, func: Fn<int, int>): int* {
	let result: int* = malloc(size * sizeof(int));

	for (let i: int = 0; i < size; i += 1) {
		result[i] = func(arr[i]);
	}

	return result;
}

fn addOne(x: int): int {
	return x + 1;
}

fn main(): void {
	let testArr: int[5] = {1, 2, 3, 4, 5};
	let result = map(testArr, 5, addOne);

	for (let i: int = 0; i < 5; i += 1) {
		out result[i];
	}
}