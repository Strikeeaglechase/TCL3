// EXPECT: Hello, World!
// EXPECT: This works!
// EXPECT: 65

fn print_string(str: int*): void {
	let idx: int = 0;
	while (str[idx] != 0) {
		out str[idx];

		idx += 1;
	}
}

fn main(): void {
	let str: int* = "Hello, World!";
	print_string(str);
	print_string("This works!");

	// ISS-008
	let inferred = "A";
	out inferred[0];
}
