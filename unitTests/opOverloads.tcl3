// EXPECT: 4
// EXPECT: 7
// EXPECT: 4
// EXPECT: 6

struct Point {
	x: int;
	y: int;

	fn "+"(other: Point): Point {
		let result: Point = {x: this->x + other.x, y: this->y + other.y};
		return result;
	}

	fn "+"(other: int): Point {
		let result: Point = {x: this->x + other, y: this->y + other};
		return result;
	}

	fn "+"(other: Point*): Point {
		let result: Point = {x: this->x + other->x, y: this->y + other->y};
		return result;
	}
}

fn main(): void {
	let a: Point = {x: 1, y: 2};
	let b: Point = {x: 3, y: 4};

 	let c: Point = a + b;
	out c.x;

	let d = a + 5;
	out d.y;

	let e: Point* = &a;
	let f: Point = b + e;
	out f.x;

	out (a + b).x + 2;
}
