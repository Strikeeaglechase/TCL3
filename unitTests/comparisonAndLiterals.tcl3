// EXPECT: 1
// EXPECT: 0
// EXPECT: 65
// EXPECT: 1
// EXPECT: 1
// EXPECT: 1
// EXPECT: 0
// EXPECT: 0
// EXPECT: 1
// EXPECT: 65
// EXPECT: 7
// EXPECT: 65
// EXPECT: 8
// EXPECT: 65
// EXPECT: 7
// EXPECT: 65

fn readInt(value: int): int value

fn readIntPointer(value: int*): int {return *value;}

fn main(): void {
	out true;
	out false;
	out 'A';

	out 3 < 4;
	out 3 <= 3;
	out 4 > 3;
	out 4 >= 5;

	out true && false;
	out false || 7;

	// ISS-007: char, bool, and int are aliases.
	let letter: char = 'A';
	let truthy: int = 7;
	out letter;
	out truthy;

	let letterPointer: char* = &letter;
	let integerPointer: char* = letterPointer;
	out *integerPointer;

	let integerValue: int = truthy + 1;
	out integerValue;

	out readInt(letter);
	out readInt(truthy);
	out readIntPointer(letterPointer);
}
